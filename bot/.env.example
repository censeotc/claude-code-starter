# Telegram source-grounded Q&A bot - environment variables.
# Copy to bot/.env for local runs (do NOT commit bot/.env).
# For Fly.io deploys, set these as Fly secrets instead:
#   fly secrets set TELEGRAM_BOT_TOKEN=... ANTHROPIC_API_KEY=... TELEGRAM_ALLOWED_USER_ID=...

# Required
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_ALLOWED_USER_ID=123456789
ANTHROPIC_API_KEY=sk-ant-...

# Optional - email mirror. If all 3 are set, every Q&A is also sent to EMAIL_TO.
# Use the same Gmail App Password you set up for the watcher.
SMTP_USER=scott@censeoai.ai
SMTP_PASS=your-16-char-google-app-password
EMAIL_TO=scott@censeoai.ai
# Optional overrides for non-Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM=scott@censeoai.ai

# Optional
CLAUDE_MODEL=claude-sonnet-4-6
MAX_HISTORY_TURNS=10
MAX_TOKENS_OUT=2000

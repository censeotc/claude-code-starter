# Copy to .env on the VPS and fill in. NEVER commit the real .env.

# --- Postgres ---
POSTGRES_USER=censeo
POSTGRES_PASSWORD=CHANGE-ME-long-random

# --- n8n ---
N8N_HOST=n8n.example.com
N8N_ENCRYPTION_KEY=CHANGE-ME-generate-with-openssl-rand-hex-32

# --- Langfuse ---
LANGFUSE_HOST=langfuse.example.com
LANGFUSE_NEXTAUTH_SECRET=CHANGE-ME-openssl-rand-hex-32
LANGFUSE_SALT=CHANGE-ME-openssl-rand-hex-16

# --- LLM APIs (bring-your-own keys; never platform-bundled credits in prod) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- GoHighLevel (system of record) ---
GHL_API_KEY=
GHL_LOCATION_ID=

# --- knowledge sync (scripts/sync-knowledge-to-pgvector.sh) ---
EMBEDDING_MODEL=text-embedding-3-small
DATABASE_URL=postgresql://censeo:CHANGE-ME@localhost:5432/censeo
